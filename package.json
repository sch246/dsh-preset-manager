{
  "name": "dsh-preset-manager",
  "version": "0.1.0",
  "description": "DSH 预设管理器：官方视图选项加“按预设”分组 + 预设显示层管理（完整顺序、独立隐藏集合与开始聊天页默认入口；重命名覆盖显示名与说明）",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "patches",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bash scripts/build.sh",
    "setup": "bash scripts/setup.sh",
    "uninstall": "bash scripts/uninstall.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "preset-manager",
    "sidebar",
    "session-grouping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sch246/dsh-preset-manager.git"
  },
  "bugs": {
    "url": "https://github.com/sch246/dsh-preset-manager/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.2-alpha.2 <2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.2-alpha.2 <2",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.2 <2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
