+  // @meta-intent:begin dsh-preset-manager session.agentPresetSelection
+  /**
+   * Select a preset for one blank live or persisted ordinary Session.
+   * A cold Session is first published with the target composition, so lookup
+   * cannot resume its previously recorded preset before the selection runs.
+   * @param sessionId - Session identity whose Agent owns the selection.
+   * @param agentPreset - target preset id.
+   * @returns the preset id committed to the Session.
+   */
+  async selectPreset(sessionId: SessionId, agentPreset: string): Promise<string> {
+    if (agentPreset.length === 0) {
+      throw new RemoteError('gateway/bad-request', 'agentPreset must be a non-empty string', {})
+    }
+    const presets = this.ctx.get('agentPresets')
+    if (presets === undefined) {
+      throw new RemoteError(
+        'gateway/internal',
+        'agent preset selection is unavailable: this deployment mounts no agent-presets service',
+        {},
+      )
+    }
+    while (true) {
+      const live = this.liveAgent(sessionId)
+      if (live !== undefined) {
+        if ('error' in live) throw live.error
+        return presets.select(live.agent, agentPreset)
+      }
+      const attached = this.ctx.sessions.get(sessionId)
+      if (attached !== undefined && hasApiSessionSubagentOwner(this.ctx, attached, undefined)) {
+        throw apiSessionSubagentOwnershipError(sessionId)
+      }
+
+      let resume = this.resumes.get(sessionId)
+      const ownsResume = resume === undefined
+      if (resume === undefined) {
+        resume = this.resume(sessionId, undefined, agentPreset)
+          .finally(() => { this.resumes.delete(sessionId) })
+        this.resumes.set(sessionId, resume)
+      }
+      try {
+        const agent = await resume
+        if (!ownsResume) return presets.select(agent, agentPreset)
+        return this.presetForSession(agent.session) ?? agentPreset
+      } catch (error: unknown) {
+        if (ownsResume && error instanceof RemoteError) throw error
+        if (!ownsResume
+          && !(error instanceof ApiSessionNotFound)
+          && !(error instanceof ApiSessionSubagentOwnership)) {
+          const raced = this.liveAgent(sessionId)
+          if (raced === undefined) continue
+          if ('error' in raced) throw raced.error
+          return presets.select(raced.agent, agentPreset)
+        }
+        if (error instanceof ApiSessionNotFound) {
+          throw new RemoteError('session/not-found', error.message, { sessionId })
+        }
+        if (error instanceof ApiSessionSubagentOwnership) {
+          throw apiSessionSubagentOwnershipError(error.sessionId)
+        }
+        throw new RemoteError(
+          'gateway/internal',
+          `resume failed for session "${sessionId}": ${String(error)}`,
+          {},
+        )
+      }
+    }
+  }
+  // @meta-intent:end dsh-preset-manager session.agentPresetSelection
+
