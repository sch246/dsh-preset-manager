diff --git a/packages/session/session-projection/src/index.ts b/packages/session/session-projection/src/index.ts
index 2b870d7bef..8850b820e1 100644
--- a/packages/session/session-projection/src/index.ts
+++ b/packages/session/session-projection/src/index.ts
@@ -451,0 +452,24 @@ export class SessionProjectionRegistry extends Service {
+  // @meta-intent:begin dsh-preset-manager (purpose: report missing current client projection rows in persisted checkpoints)
+  /**
+   * Report whether a checkpoint contains a usable row for every selected
+   * client-visible unit. Host-only units do not affect client completeness;
+   * an absent, version-mismatched, or malformed selected row is incomplete.
+   * @param checkpoint - persisted rows for one session (possibly stale or empty).
+   * @param keys - optional client-visible keys required by the consumer.
+   * @returns whether every selected registered client-visible unit can be viewed.
+   */
+  isCheckpointComplete(
+    checkpoint: ProjectionCheckpoint,
+    keys?: readonly Extract<keyof SessionProjectionMap, string>[],
+  ): boolean {
+    const values = this.viewCheckpoint(checkpoint, keys)
+    const selected = keys === undefined ? undefined : new Set<string>(keys)
+    for (const registration of this.registrations.values()) {
+      if (registration.def.wire === undefined) continue
+      if (selected !== undefined && !selected.has(registration.def.key)) continue
+      if (!(registration.def.key in values)) return false
+    }
+    return true
+  }
+  // @meta-intent:end dsh-preset-manager
+
